# === Required for production builds (Cloudflare Pages, Vercel, etc.) ===
# Your Convex deployment URL. Find it in the Convex dashboard.
# IMPORTANT: Set this as an environment variable in your Cloudflare Pages
# dashboard under "Settings > Environment variables" (not in .env.local).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL for auth (must match the site domain in production).
CONVEX_SITE_URL=https://your-site-url.com

# The deployment name Convex uses (e.g. "happy-otter-123").
# Found in the Convex dashboard. Required for `npx convex dev`.
CONVEX_DEPLOYMENT=your-deployment

# Email OTP delivery (server-side, Convex only — set via `npx convex env set VLY_EMAIL_API_KEY <key>`)
VLY_EMAIL_API_KEY=

# Freebuff auth issuer (leave default unless you have a custom one)
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com
